{
  "name": "@obinexusltd/curl-polycall",
  "version": "0.1.1",
  "description": "curl/HTTP to Python-to-native direct FFI demonstration for libpolycall.",
  "license": "MIT",
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "homepage": "https://github.com/obinexus/libpolycall/releases#release-libpolycall-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/curl-polycall.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/curl-polycall/issues"
  },
  "keywords": [
    "ffi",
    "ctypes",
    "curl",
    "polycall",
    "libpolycall",
    "native-abi"
  ],
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./ffi": "./ffi.py",
    "./server": "./server.py",
    "./bin/curl-polycall": "./bin/curl-polycall.js",
    "./bin/curl-polycall-server": "./bin/curl-polycall-server.js"
  },
  "files": [
    "bin/",
    "build/bin/.gitkeep",
    "build/obj/.gitkeep",
    "config/",
    "debian/",
    "docs/",
    "examples/",
    "scripts/",
    "src/",
    "tests/",
    "ffi.py",
    "server.py",
    "index.js",
    "Makefile",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "curl-polycall": "bin/curl-polycall.js",
    "curl-polycall-server": "bin/curl-polycall-server.js"
  },
  "directories": {
    "bin": "bin",
    "build": "build",
    "config": "config",
    "doc": "docs",
    "example": "examples",
    "lib": "src",
    "test": "tests"
  },
  "scripts": {
    "build": "make",
    "build:deb": "sh scripts/build-deb.sh",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "clean": "make clean",
    "demo": "sh examples/curl.sh",
    "demo:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File examples/curl.ps1",
    "start": "python server.py",
    "start:python3": "python3 server.py",
    "test": "npm run test:package && npm run test:bin",
    "test:bin": "node tests/bin.test.js",
    "test:ffi": "python -c \"import ffi; runtime = ffi.load(); print(runtime.command('ping'))\"",
    "test:package": "node tests/package.test.js",
    "prepack": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "libpolycallHostUrl": "https://github.com/obinexus/libpolycall/releases#release-libpolycall-1.0.0"
  },
  "libpolycall": {
    "release": "1.0.0",
    "hostUrl": "https://github.com/obinexus/libpolycall/releases#release-libpolycall-1.0.0"
  },
  "engines": {
    "node": ">=16"
  }
}
