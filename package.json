{
  "name": "@obinexusltd/curl-polycall",
  "version": "0.2.0",
  "description": "curl(1)-based client of Polycall peer nodes: polycall-peer/1 health, peers, register, send and receive over HTTP with curl.",
  "license": "MIT",
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "homepage": "https://github.com/obinexus/curl-polycall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/curl-polycall.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/curl-polycall/issues"
  },
  "keywords": [
    "curl",
    "polycall",
    "polycall-peer",
    "peer-to-peer",
    "http",
    "cli"
  ],
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./bin/curl-polycall": "./bin/curl-polycall"
  },
  "files": [
    "bin/",
    "debian/",
    "docs/",
    "examples/",
    "scripts/",
    "tests/",
    "index.js",
    "Makefile",
    "polycall-binding.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "curl-polycall": "bin/curl-polycall"
  },
  "directories": {
    "bin": "bin",
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build:deb": "sh scripts/build-deb.sh",
    "demo": "sh examples/curl.sh",
    "test": "node --test tests/package.test.js tests/bin.test.js tests/peer.test.js",
    "test:package": "node --test tests/package.test.js",
    "test:peer": "node --test tests/peer.test.js",
    "prepack": "node --test tests/package.test.js tests/bin.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "polycall": {
    "protocol": "polycall-peer/1",
    "core": "polycall >= 1.1.0",
    "core_repository": "https://github.com/obinexus/polycall"
  },
  "engines": {
    "node": ">=20"
  }
}
